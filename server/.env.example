# Server Port & Host Configuration
PORT=5000
HOST=0.0.0.0

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/resolveiq?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend Origins for Production CORS (comma-separated if multiple)
# In development, leave blank or set to your frontend dev URL.
# In Render production, set to your Render Static Site URL (e.g. https://resolveiq-client.onrender.com)
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API Key for Live Generative NLP Triage
# If omitted or offline, the platform automatically uses the built-in Intelligent Rule Engine
GEMINI_API_KEY=your_gemini_api_key_here
